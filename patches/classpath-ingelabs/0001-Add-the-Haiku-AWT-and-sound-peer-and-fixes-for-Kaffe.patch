+/* Sends the job to the printer (commit) or drops it, and frees it. */
+JNIEXPORT void JNICALL
+Java_gnu_java_awt_peer_haiku_HaikuNative_printEnd(JNIEnv *, jclass, jlong h,
+                                                  jboolean commit)
+{
+  BPrintJob *job = pjob(h);
+  if (commit)
+    job->CommitJob();
+  else
+    job->CancelJob();
+  delete job;
+}
