+/* The files ("refs") in a source as paths. */
+JNIEXPORT jobjectArray JNICALL
+Java_gnu_java_awt_peer_haiku_HaikuNative_msgFiles(JNIEnv *env, jclass,
+                                                  jint src)
+{
+  std::vector<std::string> paths;
+  pthread_mutex_lock(&gSourceLock);
