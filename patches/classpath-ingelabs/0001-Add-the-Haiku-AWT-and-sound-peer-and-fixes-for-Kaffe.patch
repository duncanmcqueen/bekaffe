+JNIEXPORT void JNICALL
+Java_gnu_java_awt_peer_haiku_HaikuNative_dispose(JNIEnv *, jclass, jlong h)
+{
+  PeerWindow *pw = win(h);
+  if (pw->Lock())
+    {
+      /* Menus belong to their Java peers; keep them out of the window's
+         destructor. */
+      BMenuBar *bar = pw->JMenuBar();
+      pw->SetJMenuBar(NULL);
+      pw->Quit();
+      if (bar != NULL)
+        releaseMenuBar(bar);
+    }
+}
