+JNIEXPORT void JNICALL
+Java_gnu_java_awt_peer_haiku_HaikuNative_menuAddItem(JNIEnv *, jclass,
+                                                     jlong menu, jlong item,
+                                                     jint index)
+{
+  BMenu *m = menuOf(menu);
+  BMenuItem *i = itemOf(item);
+  MenuLocker lock(m);
+  if (i->Menu() != NULL)
+    return;
+  if (index < 0 || index > m->CountItems())
+    m->AddItem(i);
+  else
+    m->AddItem(i, index);
