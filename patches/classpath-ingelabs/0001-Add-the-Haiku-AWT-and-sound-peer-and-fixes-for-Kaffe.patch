+JNIEXPORT jlong JNICALL
+Java_gnu_java_awt_peer_haiku_HaikuNative_menuItemCreate(JNIEnv *env, jclass,
+                                                        jint id, jstring label,
+                                                        jint shortcut,
+                                                        jint mods,
+                                                        jboolean separator)
+{
