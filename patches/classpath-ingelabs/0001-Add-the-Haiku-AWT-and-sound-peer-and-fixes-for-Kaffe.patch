+   bottom (points), first page, last page, x dpi, y dpi. */
+JNIEXPORT void JNICALL
+Java_gnu_java_awt_peer_haiku_HaikuNative_printInfo(JNIEnv *env, jclass,
+                                                   jlong h, jfloatArray out)
+{
