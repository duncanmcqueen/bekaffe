+{
+  BMenu *m = menuOf(menu);
+  BMenu *s = menuOf(sub);
+  MenuLocker lock(m);
+  if (s->Superitem() != NULL)
+    return;
+  if (index < 0 || index > m->CountItems())
+    m->AddItem(s);
+  else
+    m->AddItem(s, index);
