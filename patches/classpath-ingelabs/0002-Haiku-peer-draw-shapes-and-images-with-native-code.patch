+/* Strokes a device-space path with 1-pixel lines in a colour. */
+JNIEXPORT void JNICALL
+Java_gnu_java_awt_peer_haiku_HaikuRaster_drawPathThin(JNIEnv *env, jclass,
+                                                      jintArray dst,
+                                                      jint scan,
+                                                      jboolean alpha,
+                                                      jintArray clip,
+                                                      jfloatArray path,
+                                                      jint n, jint argb,
+                                                      jint xorBits)
+{
