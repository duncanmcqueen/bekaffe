diff --git a/kaffe/kaffevm/external.c b/kaffe/kaffevm/external.c
index 3c326a8a0..8c696c62b 100644
--- a/kaffe/kaffevm/external.c
+++ b/kaffe/kaffevm/external.c
@@ -344,13 +344,22 @@ loadNativeLibrarySym(const char* name)
 }
 
 
-static void
-strcatJNI(char* to, const char* from)
+/*
+ * Append the JNI form of from to the string in to, which is a buffer of
+ * size bytes.  Return false if the result does not fit.
+ */
+static bool
+strcatJNI(char* to, size_t size, const char* from)
 {
 	char* ptr;
 
 	ptr = &to[strlen(to)];
 	for (; *from != 0; from++) {
+		/* Each character gives at most 2; keep room for the NUL. */
+		if ((size_t)(ptr - to) + 2 >= size) {
+			*ptr = 0;
+			return false;
+		}
 		switch (*from) {
 		case '(':
 			/* Ignore */
@@ -381,6 +390,7 @@ strcatJNI(char* to, const char* from)
 
 	end:;
 	*ptr = 0;
+	return true;
 }
 
 
@@ -403,15 +413,21 @@ Kaffe_JNI_native(Method* meth)
 #else
 	strcpy(name, "Java_");
 #endif
-	strcatJNI(name, meth->class->name->data);
+	/* strcatJNI() keeps room for the "_" and "__" separators. */
+	if (!strcatJNI(name, sizeof(name), meth->class->name->data))
+		return NULL;
 	strcat(name, "_");
-	strcatJNI(name, meth->name->data);
+	if (!strcatJNI(name, sizeof(name), meth->name->data))
+		return NULL;
 
 	func = loadNativeLibrarySym(name);
 	if (func == NULL) {
 		/* Try the long signatures */
+		if (strlen(name) + 2 >= sizeof(name))
+			return NULL;
 		strcat(name, "__");
-		strcatJNI(name, METHOD_SIGD(meth));
+		if (!strcatJNI(name, sizeof(name), METHOD_SIGD(meth)))
+			return NULL;
 		func = loadNativeLibrarySym(name);
 	}
 
diff --git a/kaffe/kaffevm/object.c b/kaffe/kaffevm/object.c
index e1a393745..db98f25fe 100644
--- a/kaffe/kaffevm/object.c
+++ b/kaffe/kaffevm/object.c
@@ -17,6 +17,7 @@
 #include "config.h"
 
 #include <assert.h>
+#include <limits.h>
 
 #include "debug.h"
 #include "config-std.h"
@@ -228,9 +229,20 @@ newMultiArrayChecked(Hjava_lang_Class* clazz, int* dims, errorInfo *einfo)
   Hjava_lang_Object** array;
   int i, j, k, ndims, fullsize;
   int stacksize, stackptr;
+  jlong total;
 
-  for (i=0,fullsize=1;dims[i+1] >= 0; i++)
-    fullsize += fullsize*dims[i];
+  /* Count the arrays to make.  Stop before the count can overflow:
+   * so many arrays cannot be allocated anyway. */
+  for (i=0,total=1;dims[i+1] >= 0; i++)
+    {
+      total += total*dims[i];
+      if (total > (jlong)(INT_MAX / sizeof(Hjava_lang_Object *)))
+	{
+	  postOutOfMemory(einfo);
+	  return NULL;
+	}
+    }
+  fullsize = (int)total;
   ndims = i+1;
 
   stack = (Hjava_lang_Object **)
