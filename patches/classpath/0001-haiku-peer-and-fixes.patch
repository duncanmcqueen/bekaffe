+  BMenu *m;
+  if (kind == 0)
+    m = new BMenuBar(BRect(0, 0, 100, 20), "menubar");
+  else if (kind == 2)
+    m = new BPopUpMenu(l, false, false);
+  else
+    m = new BMenu(l);
+  free(l);
