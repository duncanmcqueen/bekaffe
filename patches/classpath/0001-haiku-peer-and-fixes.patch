+static sem_id gAppReady = -1;
+static thread_id gAppThread = -1;
+
+static int32
+appThread(void *)
+{
+  PeerApp *app = new PeerApp(gAppReady);
+  app->Run();
+  delete app;
+  return 0;
+}
