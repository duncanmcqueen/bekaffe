+import java.awt.event.ActionEvent;
+import java.awt.event.ActionListener;
+
+import javax.swing.JTextField;
+
+/**
+ * A text field drawn by Swing. This peer adds the ActionEvent for the
+ * Enter key, which SwingTextFieldPeer does not send.
+ */
+public class HaikuTextFieldPeer
+  extends SwingTextFieldPeer
+{
+
+  HaikuTextFieldPeer(final TextField tf)
+  {
+    super(tf);
+    JTextField jtf = (JTextField) swingComponent.getJComponent();
+    jtf.addActionListener(new ActionListener()
+      {
+        public void actionPerformed(ActionEvent e)
+        {
+          HaikuSwingWrapper.post(tf,
+            new ActionEvent(tf, ActionEvent.ACTION_PERFORMED, tf.getText(),
+                            e.getWhen(), e.getModifiers()), null);
+        }
+      });
+  }
+
+  /** Shows the new cursor if the mouse is over this component. */
+  public void setCursor(java.awt.Cursor cursor)
+  {
+    super.setCursor(cursor);
+    HaikuEventPump.get().refreshCursor();
+  }
+}
