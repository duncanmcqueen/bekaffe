+JNIEXPORT void JNICALL
+Java_gnu_java_awt_peer_haiku_HaikuNative_menuAddSubmenu(JNIEnv *, jclass,
+                                                        jlong menu, jlong sub,
+                                                        jint index)
+{
+  BMenu *m = menuOf(menu);
+  BMenu *s = menuOf(sub);
+  MenuLocker lock(m);
+  if (s->Superitem() != NULL)
+    return;
+  if (index < 0 || index > m->CountItems())
+    m->AddItem(s);
+  else
+    m->AddItem(s, index);
+}
